if [ -f "../deploy/env/strict.env" ]; then
  # shellcheck disable=SC1091
  . "../deploy/env/strict.env"
else
  DEPLOY_GUARD=YES
  REQUIRE_PING=1

  # SSH settings
  SSH_OPTIONS="-o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=3"

  # Default credentials for core VMs
  DEPLOY_USER="user"
  DEPLOY_PASSWORD="123"

  # Core VM IPs
  FRONTEND_IP="10.0.88.10"
  BACKEND_IP="10.0.88.20"
  DATABASE_IP="10.0.88.11"
  PARSERS_IP="10.0.88.23"

  # OSINT / ML VM
  OSINT_HOST="10.0.88.25"
  OSINT_USER="k8s-worker"
  OSINT_PASSWORD="k8s-worker"

  # OSINT API settings
  OSINT_API_PORT="8010"
  OSINT_USE_LORA="false"
  OSINT_BASE_MODEL="mistralai/Mistral-7B-v0.1"
fi
